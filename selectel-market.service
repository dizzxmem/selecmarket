[Unit]
Description=Selectel Market Telegram Bot
After=network.target

[Service]
Type=simple
User=ubuntu
WorkingDirectory=/opt/selectel-market
ExecStart=/opt/selectel-market/venv/bin/python main.py
Restart=on-failure
RestartSec=5
StandardOutput=journal
StandardError=journal
EnvironmentFile=/opt/selectel-market/.env

[Install]
WantedBy=multi-user.target
